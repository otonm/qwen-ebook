# Quadlet container unit — declarative systemd translation of run-local.sh's
# CPU-only `podman run --pod qwen-ebook -e TTS_BACKEND=http -e
# TTS_SERVICE_URL=http://localhost:8001 ...` block (DEPL-02).
#
# Reconfirm the production VM's exact `podman --version` over Tailscale SSH
# before relying on this syntax — Quadlet key set has shifted 4.4-5.x.

[Unit]
Description=Qwen Ebook backend (CPU-only)
After=qwen-ebook-pod.service qwen-ebook-tts.service
Requires=qwen-ebook-pod.service

[Container]
ContainerName=qwen-ebook-backend
Image=localhost/qwen-ebook-backend:dev
Pod=qwen-ebook.pod
# No AddDevice here — the backend never imports torch/qwen-tts and stays
# CPU-only; GPU devices are scoped to qwen-ebook-tts.container only.
Environment=TTS_BACKEND=http
Environment=TTS_SERVICE_URL=http://localhost:8001

[Install]
WantedBy=multi-user.target
